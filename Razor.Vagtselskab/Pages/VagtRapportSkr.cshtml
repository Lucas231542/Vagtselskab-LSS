@page
@model Razor.Vagtselskab.Pages.VagtRapport_skrModel
@inject global::VagtLib.IVagtRepo VagtRepo
@{
}

<h1>Mine vagter</h1>

<p>Her kan du se de vagter, du har tilmeldt dig.</p>

<hr />

@if (Model.Vagter.Count == 0)
{
    <p>Du er ikke tilmeldt nogen vagter endnu.</p>
    <a href="/Vagt" class="btn btn-primary">
        Se vagter
    </a>
}
else
{
    @foreach (var vagt in Model.Vagter)
    {

        @* var type = VagtRepo.GetById(vagt.VagtId); *@

        <div class="card p-3 mb-3">
            

            <p>
                Virksomhed: @vagt.Virksomhed <br />
                Start: @vagt.StartTid.ToString("dd-MM-yyyy HH:mm") <br />
                Slut: @vagt.SlutTid.ToString("dd-MM-yyyy HH:mm")

            </p>
            <form method="Post">
                <input type="hidden"
                       name="vagtId"
                       value="@vagt.VagtId" />
                <textarea asp-for="VagtRapport.Rapport"></textarea>
                
                <button asp-page-handler="SkrivRapport"
                        type="submit"
                        class="btn btn-danger">
                    Skriv rapport
                </button>
            </form>


        </div>
    }
}




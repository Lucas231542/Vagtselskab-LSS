@page
@model Razor.Vagtselskab.Pages.VagtModel

<h1>Vagtsystem</h1>

<hr />

<h2>Opret vagt</h2>

<form method="post" asp-page-handler="Opret">
    <div>
        <label>Virksomhed</label>
        <input asp-for="Vagt.Virksomhed" />
    </div>
   

    <div>
        <label>Starttid</label>
        <input asp-for="Vagt.StartTid" type="datetime-local" />
    </div>

    <div>
        <label>Sluttid</label>
        <input asp-for="Vagt.SlutTid" type="datetime-local" />
    </div>

    <div>
        <label>Adresse</label>
        <input asp-for="Vagt.Adresse" />
    </div>

    <div>
        <label>Kundens Opgave Beskrivelse</label>
        <input asp-for="Vagt.KundensOpgaveBeskrivelse" />
    </div>

    <div>
        <label>LSS Beskrivelse</label>
        <input asp-for="Vagt.LSSBeskrivelse" />
    </div>

    <div>
        <label>Krav</label>
        <input asp-for="Vagt.Krav" />
    </div>

    <div>
        <label>Antal Medarbejder</label>
        <input asp-for="Vagt.AntalMedarbejder" type="number" />
    </div>

    <button type="submit">Opret vagt</button>

</form>

<hr />

<h2>Rediger vagt</h2>

<form method="post" asp-page-handler="Rediger">

    <div>
        <label>Vagt ID</label>
        <input asp-for="Vagt.VagtId" type="number" />
    </div>



    <div>
        <label>Virksomhed</label>
        <input asp-for="Vagt.Virksomhed" />
    </div>

    <div>
        <label>Starttid</label>
        <input asp-for="Vagt.StartTid" type="datetime-local" />
    </div>

    <div>
        <label>Sluttid</label>
        <input asp-for="Vagt.SlutTid" type="datetime-local" />
    </div>
    <div>
        <label>Adresse</label>
        <input asp-for="Vagt.Adresse" />
    </div>

    <div>
        <label>Kundens opgave beskrivelse</label>
        <input asp-for="Vagt.KundensOpgaveBeskrivelse" />
    </div>
    <div>
        <label>LSS opgave beskrivelse</label>
        <input asp-for="Vagt.LSSBeskrivelse" />
    </div>

    <div>
        <label>Krav</label>
        <input asp-for="Vagt.Krav" />
    </div>

    <div>
        <label>Antal medarbejdere</label>
        <input asp-for="Vagt.AntalMedarbejder" />
    </div>
   
    
    <button type="submit">Gem ændringer</button>

</form>

<hr />

<h2>Slet vagt</h2>

<form method="post" asp-page-handler="Slet">

    <div>
        <label>Vagt ID</label>
        <input type="number" name="id" />
    </div>

    <button type="submit">Slet vagt</button>

</form>

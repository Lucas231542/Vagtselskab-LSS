@page
@model Razor.Vagtselskab.Pages.VagtModel

<h1>Vagtsystem</h1>

<hr />

<h2>Opret vagt</h2>

<form method="post" asp-page-handler="Opret">

    <div>
        <label>Medarbejder</label>
        <input asp-for="Vagt.Medarbejder" />
    </div>

    <div>
        <label>Starttid</label>
        <input asp-for="Vagt.StartTid" type="datetime-local" />
    </div>

    <div>
        <label>Sluttid</label>
        <input asp-for="Vagt.SlutTid" type="datetime-local" />
    </div>

    <button type="submit">Opret vagt</button>

</form>

<hr />

<h2>Rediger vagt</h2>

<form method="post" asp-page-handler="Rediger">

    <div>
        <label>Vagt ID</label>
        <input asp-for="Vagt.VagtId" type="number" />
    </div>

    <div>
        <label>Medarbejder</label>
        <input asp-for="Vagt.Medarbejder" />
    </div>

    <div>
        <label>Starttid</label>
        <input asp-for="Vagt.StartTid" type="datetime-local" />
    </div>

    <div>
        <label>Sluttid</label>
        <input asp-for="Vagt.SlutTid" type="datetime-local" />
    </div>

    <button type="submit">Gem ændringer</button>

</form>

<hr />

<h2>Slet vagt</h2>

<form method="post" asp-page-handler="Slet">

    <div>
        <label>Vagt ID</label>
        <input type="number" name="id" />
    </div>

    <button type="submit">Slet vagt</button>

</form>
